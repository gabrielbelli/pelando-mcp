# Polite scraping config.
#
# The User-Agent identifies us truthfully. Pelando's robots.txt permits everything we touch, and
# the operator curates a bot blocklist by hand — if we ever become a nuisance we would rather be
# emailed than blocked. Do not replace this with a browser UA string.
PELANDO_USER_AGENT="pelando-mcp/0.1 (+https://github.com/gabrielbelli/pelando-mcp)"

# 1 req/s is intentionally polite. Measured headroom is larger; don't raise it without reason.
PELANDO_RATE_LIMIT_RPS=1.0
PELANDO_RATE_LIMIT_BURST=3

# Cache
PELANDO_CACHE_PATH=/data/cache.sqlite

# Logging
PELANDO_LOG_LEVEL=INFO
